# Runtime Environment ("development" locally, "production" on Vercel)
APP_ENV=development

# Persistent Community Reports Database (auto-injected when enabling Postgres Storage)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Real-time Traffic Flow Anomaly Detection (TomTom Free Evaluation Tier)
# TOMTOM_API_KEY=your_tomtom_api_key_here

# Optional VRain Ground Rain Gauge Open API Key (dev.vrain.vn)
# VRAIN_API_KEY=your_vrain_api_key_here

# Optional Municipal IOC Traffic Camera Feeds JSON map keyed by camera station id (e.g. cam_32_mauthan)
# IOC_CAMERA_FEEDS_JSON={"cam_32_mauthan":"https://example.cantho.gov.vn/cam01.jpg"}

# Comma-separated allowed CORS origins in production (never use *)
# ALLOWED_ORIGINS=https://cantho-hydro-atlas.vercel.app

# Per-IP API rate limits (requests per 60s sliding window)
RATE_LIMIT_WRITE_RPM=12
RATE_LIMIT_COMPUTE_RPM=60
RATE_LIMIT_READ_RPM=120
REFRESH_COOLDOWN_SEC=60
